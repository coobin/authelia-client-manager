# Copy outside the source repository. Never commit real deployment parameters.
ACM_IMAGE=authelia-client-manager:0.2.1
ACM_UID=10001
ACM_GID=10001
ACM_DOCKER_GID=999
ACM_BIND=127.0.0.1
ACM_ORIGIN=https://manager.example.com
ACM_SECURE_COOKIE=1
ACM_WEB_DATA=/srv/acm-private/web
ACM_AGENT_DATA=/srv/acm-private/agent
ACM_SOCKET_DIR=/srv/acm-private/socket
ACM_PROVIDER_DIR=/srv/authelia/config
ACM_TARGET=authelia
ACM_INSIDE_CONFIG=/config/configuration.yml
ACM_ISSUER=https://auth.example.com
ACM_WRITABLE=0
# Optional employee application portal. Store its confidential client secret in
# the private web data directory, never in this env file or the repository.
ACM_OIDC_ISSUER=
ACM_OIDC_CLIENT_ID=
ACM_OIDC_SECRET_FILE=/data/applicant-oidc.secret
